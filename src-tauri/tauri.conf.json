{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SplitStream",
  "version": "1.0.0",
  "identifier": "com.robyrew.splitstream",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "SplitStream",
        "width": 480,
        "height": 680,
        "resizable": false,
        "center": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica"
          ],
          "state": "active"
        }
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/*"
    ],
    "shortDescription": "Send one app through your own server",
    "longDescription": "Splits off a single application's traffic and sends it through your own server, leaving everything else on the default connection.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBRDM5MzBFNjVBNjU5NzgKUldSNFdhWmxEcFBUcWxYV01wOUJkWmtpdjNiMHJndnYrRFpPMFV0dHI3eHlxc0JyaElpTHJFQXAK",
      "endpoints": [
        "https://github.com/RobyRew/split-stream/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
